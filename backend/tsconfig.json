{
  "compilerOptions": {
    "module": "commonjs",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2021", "DOM"],
    // "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["node_modules/@types", "src/types"]
  },
  "include": ["src/**/*"]
}
